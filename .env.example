# Copie para .env e ajuste.

# Domínio apontando para o servidor (o Caddy emite o certificado HTTPS sozinho).
# Sem domínio, use <ip-com-hifens>.sslip.io, por exemplo 203-0-113-10.sslip.io
DOMAIN=discordia.exemplo.com

# IP público do servidor, anunciado para o WebRTC. Obrigatório em cloud/VPS.
RTC_PUBLIC_IP=203.0.113.10

# STUN/TURN entregues aos navegadores (separados por vírgula).
# RTC_ICE_SERVERS=stun:stun.l.google.com:19302
